# Copy this file to ".env.local" and fill in your keys.

# OpenAI — the "main brain" that scores each factor and gives the call.
# Get a key at: https://platform.openai.com/api-keys
# Without it, the app falls back to a built-in heuristic model.
OPENAI_API_KEY=
# Which OpenAI model to use (default gpt-4o for the deepest analysis).
OPENAI_MODEL=gpt-4o

# FRED (Federal Reserve Economic Data) — FREE API key.
# Used as the fallback source for every metric when a live website is down.
# Get one in ~1 minute at: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# Optional: BLS registration key — raises CPI/NFP rate limits.
# Free signup: https://data.bls.gov/registrationEngine/
BLS_API_KEY=

# Optional: how many minutes the server caches macro data (default 15).
MACRO_CACHE_MINUTES=15

# Paper-trading storage (PHP/MySQL backend). Leave URL blank to run paper
# trading in-memory only. Token must match $API_TOKEN in NewIssueBot/config.php.
PAPER_API_URL=
PAPER_API_TOKEN=

# Authentication endpoint (signup/login/OTP). Same PHP host as paper trading.
# If left blank, it is derived from PAPER_API_URL (api.php -> auth.php).
AUTH_API_URL=
